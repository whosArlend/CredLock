# ========================================================
# CredLock API — Backend .gitignore
# ========================================================

# Dependencies
node_modules/

# Production build outputs
dist/

# Environment files
.env
.env.*
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage artifacts
coverage/

# Temporary caches
*.tsbuildinfo
.eslintcache

# OS specific files
.DS_Store
Thumbs.db
[Dd]esktop.ini
