# ==============================================================================
# CredLock Security Intelligence API Environment Configuration (.env.example)
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - This file is for the BACKEND service only (backend/credlock-api).
# - NEVER commit your actual .env file or production secret keys to version control.
# - SUPABASE_SECRET_KEY bypasses Row Level Security (RLS) and must NEVER be
#   exposed to the frontend, browser bundles, or public repositories.
#
# ==============================================================================
# 1. Server & Runtime Settings
# ==============================================================================
NODE_ENV=development
PORT=4000

# ==============================================================================
# 2. CORS Whitelist
# ==============================================================================
# Allowed origin(s) for Cross-Origin Resource Sharing.
# Supports comma-separated origins for production and preview domains.
#
# Local development default:
FRONTEND_URL=http://localhost:5173
#
# Vercel Production example:
# FRONTEND_URL=https://credlock.vercel.app,http://localhost:5173

# ==============================================================================
# 3. Supabase Database Configuration
# ==============================================================================
# Required for database-backed endpoints (Dashboard, Breaches, Recommendations, Articles).
# Obtain these from your Supabase Project Settings > API:
#
# - SUPABASE_URL: Project URL (format: https://xyzcompany.supabase.co)
# - SUPABASE_SECRET_KEY: Service Role Key (format: sb_secret_... or legacy JWT secret)
#
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
