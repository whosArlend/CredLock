# ==============================================================================
# CredLock Security Intelligence API - Environment Variables Example
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local development.
# IMPORTANT: Never commit actual secret keys or credentials to version control.

# Application Environment (development | production | test)
NODE_ENV=development

# Backend Server Listening Port (Default: 4000)
# (Avoid conflict with Sales-API on 3000 and CredLock PWA on 5173)
PORT=4000

# Allowed Frontend Origins for CORS (comma-separated or single origin)
FRONTEND_URL=http://localhost:5173
