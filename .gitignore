# ========================================================
# CredLock v2.0.0 — Comprehensive .gitignore
# ========================================================

# 1. Dependencies
node_modules/
backend/**/node_modules/
.pnp
.pnp.js

# 2. Production & Build Outputs
dist/
dist-ssr/
build/
out/
backend/**/dist/
.vite/
.cache/

# 3. Environment & Secret Credentials
.env
.env.*
.env.local
.env.development.local
.env.production.local
.env.test.local
backend/**/.env
backend/**/.env.local
backend/**/.env.*.local
*.local
*.pem
*.key
*.cert
*.pfx
*.pkcs12

# Explicitly track safe example environment templates
!.env.example
!backend/**/.env.example

# 4. Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Test & Coverage Artifacts
coverage/
*.lcov
.nyc_output

# 6. Temporary Cache & Build Info
.eslintcache
.stylelintcache
*.tsbuildinfo

# 7. IDE, Editor & User Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.tmp
*.bak

# 8. Operating System Artifacts
.DS_Store
.DS_Store?
._*
[Tt]humbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# 9. Local Agent, Diagnostic & Screenshot Tools
.taste-skill/
shots/
