# ==============================================================================
# CredLock Frontend Environment Configuration (.env.example)
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - Original passwords, hashes, and encryption keys must NEVER be transmitted over
#   the network or stored in environment variables.
# - Only variables prefixed with VITE_ are exposed to the client-side bundle.
# - NEVER place backend secrets (e.g. Supabase Secret Key / Service Role Key) in this file.
#
# ==============================================================================
# 1. CredLock Security Intelligence API Base URL
# ==============================================================================
# In local development:
# Points to the local Express backend (port 4000 by default).
VITE_CREDLOCK_API_URL=http://localhost:4000

# In Vercel Production deployment:
# Set this in your Vercel Project Settings > Environment Variables:
# VITE_CREDLOCK_API_URL=https://credlock-api.vercel.app

# ==============================================================================
# 2. Supabase Auth & Public Cloud Client Configuration (Phase 1)
# ==============================================================================
# Required for Supabase Auth (Sign Up, Session Management).
# Use ONLY your public project URL and public ANON (publishable) key.
#
# Obtain these from: Supabase Dashboard > Project Settings > API
# - VITE_SUPABASE_URL: Project URL (e.g. https://your-project.supabase.co)
# - VITE_SUPABASE_ANON_KEY: Public Anon Key (safe for browser exposure with RLS)
#
# NEVER set SUPABASE_SECRET_KEY or service_role key here!
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# ==============================================================================
# 3. Application Environment
# ==============================================================================
VITE_APP_ENV=development
